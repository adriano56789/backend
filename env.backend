BASE_URL=http://localhost:3000

# --- Configuração de CORS ---
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://livego.store,https://www.livego.store,http://192.168.3.12:5173,http://192.168.3.61:5173,http://192.168.3.62:5173

